@model GestionAlquileres.ViewModels.Flota.FlotaUsuariosMobileViewModel
@{
    ViewData["Title"] = Model.Titulo;
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}
<link href="~/css/flota/flota.css" rel="stylesheet" asp-append-version="true" />

<form id="flotaUsuariosMobileToken">@Html.AntiForgeryToken()</form>

<main class="fleet-admin-page">
    <header class="fleet-admin-head">
        <div>
            <span class="fleet-admin-head__eyebrow">Flota · maestro urgente</span>
            <h1>@Model.Titulo</h1>
            <p>Aquí administramos teléfono, chofer, contrato fijo opcional, estado y reset de PIN sin tocar usuarios generales del sistema. El login mobile sigue viviendo solo en <code>flota.UsuarioMobile</code>.</p>
        </div>
        <div class="fleet-admin-actions">
            <a class="fleet-soft-btn" href="@Url.Action("MobileLogin","Flota")">Probar MobileLogin</a>
            <a class="fleet-soft-btn" href="@Url.Action("Contratos","Flota")">Ver contratos</a>
        </div>
    </header>

    <section class="fleet-admin-layout">
        <div class="fleet-stack">
            <article class="fleet-panel-card">
                <div class="fleet-panel-card__head">
                    <div>
                        <h2>Usuarios mobile registrados</h2>
                        <p>Listado operativo para piloto: contrato fijo, chofer asignado, estado, último acceso y acciones administrativas controladas.</p>
                    </div>
                    <div class="fleet-admin-actions">
                        <button id="btnNuevoUsuarioMobile" type="button" class="fleet-btn fleet-btn-primary">
                            <i class="bi bi-person-plus"></i> Nuevo usuario
                        </button>
                        <button id="btnRecargarUsuariosMobile" type="button" class="fleet-btn fleet-btn-soft">
                            <i class="bi bi-arrow-clockwise"></i> Recargar
                        </button>
                    </div>
                </div>
                <div class="fleet-panel-card__body">
                    <div class="fleet-kpi">
                        <article><span>Activos</span><strong id="kpiUsuariosActivos">0</strong></article>
                        <article><span>Inactivos</span><strong id="kpiUsuariosInactivos">0</strong></article>
                        <article><span>Con contrato fijo</span><strong id="kpiUsuariosConContrato">0</strong></article>
                    </div>

                    <div class="fleet-table-wrap mt-3">
                        <table class="fleet-table">
                            <thead>
                                <tr>
                                    <th>Teléfono</th>
                                    <th>Nombre</th>
                                    <th>Chofer</th>
                                    <th>Documento</th>
                                    <th>Contrato</th>
                                    <th>Placa</th>
                                    <th>Estado</th>
                                    <th>Último login</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="usuariosMobileRows">
                                <tr><td colspan="9" class="fleet-empty">Cargando usuarios mobile...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>
        </div>

        <aside class="fleet-stack">
            <article class="fleet-panel-card">
                <div class="fleet-panel-card__head">
                    <div>
                        <h2 id="usuarioMobileFormTitle">Nuevo usuario mobile</h2>
                        <p>Alta y edición básica. El PIN solo se pide al crear o al resetear; nunca se muestra ni se persiste en texto plano.</p>
                    </div>
                </div>
                <div class="fleet-panel-card__body">
                    <form id="formUsuarioMobile" class="fleet-inline-form">
                        <input id="usuarioMobileId" type="hidden" value="0" />
                        <div class="fleet-inline-form__grid">
                            <label>
                                Chofer
                                <select id="usuarioMobileChofer"></select>
                            </label>
                            <label>
                                Contrato fijo opcional
                                <select id="usuarioMobileContrato"></select>
                            </label>
                            <label>
                                Estado inicial
                                <select id="usuarioMobileEstado">
                                    <option value="A">Activo</option>
                                    <option value="X">Inactivo</option>
                                </select>
                            </label>
                            <label>
                                Teléfono
                                <input id="usuarioMobileTelefono" type="tel" maxlength="20" />
                            </label>
                            <label>
                                Nombre visible
                                <input id="usuarioMobileNombre" maxlength="150" />
                            </label>
                        </div>

                        <div id="usuarioMobilePinWrap" class="fleet-inline-form__grid">
                            <label>
                                PIN temporal inicial
                                <input id="usuarioMobilePin" type="password" inputmode="numeric" minlength="6" maxlength="12" autocomplete="new-password" />
                            </label>
                            <label>
                                Confirmar PIN
                                <input id="usuarioMobilePinConfirmar" type="password" inputmode="numeric" minlength="6" maxlength="12" autocomplete="new-password" />
                            </label>
                        </div>

                        <div class="fleet-note">El usuario mobile pertenece al chofer. El contrato puede asignarse después. Si no tiene contrato fijo, no podrá operar en Estación Mobile hasta que administración lo asigne.</div>

                        <div class="fleet-admin-actions">
                            <button id="btnGuardarUsuarioMobile" type="submit" class="fleet-btn fleet-btn-primary">
                                <i class="bi bi-save"></i> Guardar usuario
                            </button>
                            <button id="btnCancelarEdicionUsuarioMobile" type="button" class="fleet-btn fleet-btn-soft fleet-hidden">
                                <i class="bi bi-x-circle"></i> Cancelar edición
                            </button>
                        </div>
                    </form>
                </div>
            </article>

            <article class="fleet-panel-card">
                <div class="fleet-panel-card__head">
                    <div>
                        <h2>Acciones administrativas</h2>
                        <p>Selecciona un usuario del listado para cambiar contrato fijo, activar/inactivar o resetear el PIN.</p>
                    </div>
                </div>
                <div class="fleet-panel-card__body">
                    <div id="usuarioMobileVacio" class="fleet-empty">Elige un usuario mobile para ver su contexto y operar con seguridad.</div>

                    <div id="usuarioMobilePanel" class="fleet-stack fleet-hidden">
                        <div class="fleet-detail-list">
                            <article class="fleet-detail-item"><span>Teléfono</span><strong id="detalleUsuarioTelefono">-</strong></article>
                            <article class="fleet-detail-item"><span>Estado</span><strong id="detalleUsuarioEstado">-</strong></article>
                            <article class="fleet-detail-item"><span>Nombre</span><strong id="detalleUsuarioNombre">-</strong></article>
                            <article class="fleet-detail-item"><span>Chofer</span><strong id="detalleUsuarioChofer">-</strong></article>
                            <article class="fleet-detail-item"><span>Documento</span><strong id="detalleUsuarioDocumento">-</strong></article>
                            <article class="fleet-detail-item"><span>Contrato fijo</span><strong id="detalleUsuarioContrato">-</strong></article>
                            <article class="fleet-detail-item"><span>Placa</span><strong id="detalleUsuarioPlaca">-</strong></article>
                            <article class="fleet-detail-item"><span>Último login</span><strong id="detalleUsuarioUltimoLogin">-</strong></article>
                        </div>

                        <div class="fleet-admin-actions">
                            <button id="btnEditarUsuarioMobile" type="button" class="fleet-btn fleet-btn-soft">
                                <i class="bi bi-pencil-square"></i> Editar datos
                            </button>
                            <button id="btnToggleEstadoUsuarioMobile" type="button" class="fleet-btn fleet-btn-danger">
                                <i class="bi bi-pause-circle"></i> Cambiar estado
                            </button>
                        </div>

                        <form id="formCambiarContratoMobile" class="fleet-inline-form">
                            <label>
                                Reasignar contrato fijo
                                <select id="usuarioMobileContratoCambio"></select>
                            </label>
                            <button type="submit" class="fleet-btn fleet-btn-success">
                                <i class="bi bi-arrow-repeat"></i> Cambiar contrato fijo
                            </button>
                        </form>
                        <button id="btnQuitarContratoUsuarioMobile" type="button" class="fleet-btn fleet-btn-soft">
                            <i class="bi bi-unlink"></i> Quitar contrato fijo
                        </button>

                        <div class="fleet-note">El reset reactiva el usuario y reemplaza hash/salt desde backend usando <code>FlotaMobilePasswordHasher</code>.</div>

                        <form id="formResetPinMobile" class="fleet-inline-form">
                            <label>
                                Nuevo PIN temporal
                                <input id="resetPin" type="password" inputmode="numeric" minlength="6" maxlength="12" autocomplete="new-password" />
                            </label>
                            <label>
                                Confirmar PIN
                                <input id="resetPinConfirmar" type="password" inputmode="numeric" minlength="6" maxlength="12" autocomplete="new-password" />
                            </label>
                            <button type="submit" class="fleet-btn fleet-btn-primary">
                                <i class="bi bi-key"></i> Resetear PIN mobile
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        </aside>
    </section>
</main>

@section Scripts{
    <script src="~/js/flota/flotaUsuariosMobile.js" asp-append-version="true"></script>
}
