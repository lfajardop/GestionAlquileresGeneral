@model GestionAlquileres.ViewModels.Flota.FlotaMobileLoginViewModel
@{
    ViewData["Title"] = Model.Titulo;
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}
<form id="flotaMobileLoginToken">@Html.AntiForgeryToken()</form>

<style>
    .fml-page { max-width: 460px; margin: 0 auto; padding: 1.4rem 1rem 4rem; }
    .fml-hero { background: linear-gradient(135deg, #0f3e53, #126e6a); color: #fff; border-radius: 22px; padding: 1.25rem; box-shadow: 0 12px 28px rgba(17,59,83,.22); }
    .fml-hero small { display: block; opacity: .85; text-transform: uppercase; letter-spacing: .08em; }
    .fml-hero strong { display: block; margin-top: .35rem; font-size: 1.15rem; }
    .fml-box { background: #fff; margin-top: 1rem; border-radius: 20px; padding: 1rem; border: 1px solid #e6edf2; box-shadow: 0 10px 28px rgba(16,24,40,.08); }
    .fml-field { margin-bottom: .85rem; }
    .fml-field label { display: block; margin-bottom: .3rem; font-size: .85rem; font-weight: 700; color: #355063; }
    .fml-field input { width: 100%; border: 1px solid #cbd7df; border-radius: 14px; padding: .92rem .95rem; font-size: 1rem; background: #fbfdfe; }
    .fml-btn { width: 100%; border: 0; border-radius: 16px; padding: .95rem 1rem; background: #0f766e; color: #fff; font-weight: 700; font-size: 1rem; }
    .fml-note { margin-top: .75rem; color: #5b7283; font-size: .92rem; }
    .fml-feedback { display:none; margin-top:1rem; border-radius:14px; padding:.85rem .95rem; font-weight:600; }
    .fml-feedback.show { display:block; }
    .fml-feedback.error { background:#fff1f1; color:#b42318; border:1px solid #f4c7c3; }
</style>

<main class="fml-page">
    <section class="fml-hero">
        <small>Acceso mobile temporal</small>
        <strong>@Model.Titulo</strong>
        <div class="fml-note">@Model.TodoSeguridad</div>
    </section>

    <section class="fml-box">
        <div id="fmlFeedback" class="fml-feedback error" role="alert"></div>
        <div class="fml-field">
            <label for="fmlTelefono">Telefono</label>
            <input id="fmlTelefono" type="tel" inputmode="tel" autocomplete="username" value="@Model.Telefono" />
        </div>
        <div class="fml-field">
            <label for="fmlPin">PIN o contrasena temporal</label>
            <input id="fmlPin" type="password" inputmode="numeric" autocomplete="current-password" />
        </div>
        <button id="fmlIngresar" type="button" class="fml-btn">Ingresar</button>
        <div class="fml-note">La sesion se mantiene por 30 dias en este dispositivo, salvo cierre manual o borrado de cookies.</div>
    </section>
</main>

@section Scripts {
    <script src="~/js/flota/flotaMobileLogin.js" asp-append-version="true"></script>
}
