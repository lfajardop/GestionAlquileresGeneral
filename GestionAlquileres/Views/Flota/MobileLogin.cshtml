@model GestionAlquileres.ViewModels.Flota.FlotaMobileLoginViewModel
@{
    ViewData["Title"] = Model.Titulo;
    Layout = "~/Views/Shared/_FlotaMobileLayout.cshtml";
}
<form id="flotaMobileLoginToken">@Html.AntiForgeryToken()</form>

<main class="fml-page">
    <header class="fml-topbar">
        <div class="fml-brand">
            <span class="fml-brand-dot"></span>
            <span>Flota Mobile</span>
        </div>
        <div class="fml-status">Acceso seguro</div>
    </header>

    <section class="fml-hero fm-panel-card">
        <small>Acceso mobile temporal</small>
        <strong>@Model.Titulo</strong>
        <div class="fml-note">@Model.TodoSeguridad</div>
    </section>

    <section class="fml-box">
        <div id="fmlFeedback" class="fml-feedback error" role="alert"></div>
        <div class="fml-field">
            <label for="fmlTelefono">Telefono</label>
            <input id="fmlTelefono" type="tel" inputmode="tel" autocomplete="username" value="@Model.Telefono" />
        </div>
        <div class="fml-field">
            <label for="fmlPin">PIN o contrasena temporal</label>
            <input id="fmlPin" type="password" inputmode="numeric" autocomplete="current-password" />
        </div>
        <div class="fm-login-actions">
            <button id="fmlIngresar" type="button" class="fml-btn">Ingresar</button>
        </div>
        <div class="fml-note">La sesion se mantiene por 30 dias en este dispositivo, salvo cierre manual o borrado de cookies.</div>
    </section>
</main>

@section Scripts {
    <script src="~/js/flota/flotaMobileLogin.js" asp-append-version="true"></script>
}
