@model GestionAlquileres.ViewModels.Flota.FlotaEstacionMobileViewModel
@{
    ViewData["Title"] = Model.TituloPantalla;
    Layout = "~/Views/Shared/_FlotaMobileLayout.cshtml";
}
<form id="flotaMobileToken">@Html.AntiForgeryToken()</form>

<main class="fm-mobile-page fm-page" data-contrato-fijo="@(Model.IdContratoAsignado?.ToString() ?? "")" data-puede-cambiar-contrato="@(Model.PuedeCambiarContrato ? "1" : "0")" data-tab-inicial="@Model.TabInicial" data-fecha-maxima="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")">
    <header class="fm-mobile-topbar">
        <div class="fm-brand">
            <span class="fm-brand-dot"></span>
            <span>Flota Mobile</span>
        </div>
        <div class="fm-mobile-status">Modo estacion</div>
    </header>

    <section class="fm-banner fm-panel-card">
        <small>Desarrollo controlado</small>
        <strong>@Model.TituloPantalla</strong>
        <div class="fm-security">@Model.TodoSeguridad</div>
        <div class="fm-topbar">
            <div class="fm-user">
                <div><strong>@(string.IsNullOrWhiteSpace(Model.NombreSesion) ? "Usuario mobile" : Model.NombreSesion)</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.TelefonoSesion))
                {
                    <div>@Model.TelefonoSesion</div>
                }
            </div>
            <button id="fmLogout" type="button" class="fm-icon-btn fm-icon-btn-danger" title="Cerrar sesión" data-bs-toggle="tooltip" data-bs-placement="left" aria-label="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </section>

    <div id="fmFeedback" class="fm-feedback" role="alert"></div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeContrato))
    {
        <section class="fm-card">
            <div class="fm-help">@Model.MensajeContrato</div>
        </section>
    }

    <section class="fm-card">
        <h3>Contrato activo</h3>
        @if (Model.PuedeCambiarContrato)
        {
            <div class="fm-field">
                <label for="fmContrato">Selecciona contrato</label>
                <select id="fmContrato">
                    <option value="">Cargando contratos...</option>
                </select>
            </div>
        }
        else
        {
            @if (!Model.PuedeOperar)
            {
                <div class="fm-lock">No tiene contrato activo asignado. Comuniquese con administracion.</div>
            }
            <select id="fmContrato" hidden>
                <option value="">Contrato activo</option>
            </select>
        }
        <div id="fmContratoResumen" class="fm-readonly-strip fm-contract-summary" style="display:none;">
            <div class="fm-section-title">
                <div>
                    <div class="fm-chip-row">
                        <span id="fmPlacaChip" class="fm-chip" title="Vehículo del contrato activo" data-bs-toggle="tooltip">Placa -</span>
                        <span id="fmContratoChip" class="fm-chip fm-chip-accent" title="Contrato operativo activo" data-bs-toggle="tooltip">Contrato -</span>
                    </div>
                    <div class="fm-muted fm-contract-caption" id="fmContratoCompacto">Chofer y modalidad del contrato activo</div>
                </div>
                <button id="fmToggleContratoResumen" type="button" class="fm-btn fm-btn-soft">Ver datos</button>
            </div>
            <div id="fmContratoDetalle" style="display:none;">
                <div>
                    <div class="fm-muted">Contrato</div>
                    <strong id="fmContratoNumero">-</strong>
                </div>
                <div>
                    <div class="fm-muted">Chofer</div>
                    <strong id="fmChofer">-</strong>
                </div>
                <div>
                    <div class="fm-muted">Placa</div>
                    <strong id="fmPlaca">-</strong>
                </div>
                <div class="fm-pill-row">
                    <span id="fmModalidad" class="fm-pill">Modalidad</span>
                    <span id="fmPeriodicidad" class="fm-pill">Periodicidad</span>
                </div>
            </div>
        </div>
    </section>

    <section class="fm-card">
        <div class="fm-section-title">
            <div>
                <h3>Resumen global</h3>
                <div class="fm-help">Estado acumulado del chofer considerando todos sus contratos.</div>
            </div>
            <button id="fmRefrescarResumenGlobal" type="button" class="fm-btn fm-btn-soft fm-btn-inline">Actualizar</button>
        </div>
        <div id="fmResumenGlobal" class="fm-summary-band fm-summary-band-2">
            <div class="fm-summary-box">
                <span>Deuda real</span>
                <strong id="fmResumenDeuda">S/.0.00</strong>
            </div>
            <div class="fm-summary-box">
                <span>Pagado real</span>
                <strong id="fmResumenPagado">S/.0.00</strong>
            </div>
            <div class="fm-summary-box">
                <span>Saldo real</span>
                <strong id="fmResumenSaldo">S/.0.00</strong>
            </div>
            <div class="fm-summary-box">
                <span>Pago declarado pendiente</span>
                <strong id="fmResumenPendiente">S/.0.00</strong>
            </div>
            <div class="fm-summary-box">
                <span>Validado no aplicado</span>
                <strong id="fmResumenValidado">S/.0.00</strong>
            </div>
        </div>
        <div class="fm-inline-message">Los pagos declarados se muestran separados y todavía no descuentan recibos.</div>
    </section>

    <section id="fmPanelIntervalos" class="fm-panel active">
        <div class="fm-card">
            <div class="fm-section-title">
                <div>
                    <h3>Intervalos del dia operativo</h3>
                    <div class="fm-help">Puedes abrir y cerrar varios intervalos en el mismo dia. Si cruzas medianoche, el intervalo sigue perteneciendo al dia de inicio.</div>
                </div>
                <span id="fmBadgeIntervaloAbierto" class="fm-state fm-state-info" style="display:none;">Uso abierto</span>
            </div>
            <div id="fmResumenHorasDia" class="fm-summary-band fm-summary-band-2">
                <div class="fm-summary-box">
                    <span>Total horas acumuladas</span>
                    <strong id="fmTotalHorasDia">0.00 h</strong>
                </div>
                <div class="fm-summary-box">
                    <span>Intervalos cerrados</span>
                    <strong id="fmCantidadIntervalos">0</strong>
                </div>
            </div>
            <div id="fmAlertaHoras" class="fm-lock" style="display:none;"></div>
        </div>

        <div class="fm-card">
            <h3>Iniciar uso</h3>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmFechaOperacion">Fecha operativa</label>
                    <input id="fmFechaOperacion" type="date" value="@Model.FechaOperacionInicial.ToString("yyyy-MM-dd")" max="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fm-field">
                    <label for="fmHoraInicioIntervalo">Hora inicio</label>
                    <input id="fmHoraInicioIntervalo" type="time" />
                </div>
                <div class="fm-field">
                    <label for="fmKmInicial">Km inicial</label>
                    <input id="fmKmInicial" type="number" step="0.01" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmObservacionIntervaloInicio">Observacion de inicio</label>
                    <textarea id="fmObservacionIntervaloInicio" placeholder="Opcional"></textarea>
                </div>
            </div>
            <div class="fm-help">Solo puede existir un intervalo abierto a la vez para el mismo contrato, chofer y vehiculo.</div>
            <div class="fm-sticky">
                <button id="fmAbrirIntervalo" type="button" class="fm-btn fm-btn-primary">Iniciar uso</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Cerrar uso</h3>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmFechaFinIntervalo">Fecha cierre</label>
                    <input id="fmFechaFinIntervalo" type="date" value="@Model.FechaOperacionInicial.ToString("yyyy-MM-dd")" max="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fm-field">
                    <label for="fmHoraFinIntervalo">Hora cierre</label>
                    <input id="fmHoraFinIntervalo" type="time" />
                </div>
                <div class="fm-field">
                    <label for="fmKmFinal">Km final</label>
                    <input id="fmKmFinal" type="number" step="0.01" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmObservacionIntervaloFin">Observacion de cierre</label>
                    <textarea id="fmObservacionIntervaloFin" placeholder="Opcional"></textarea>
                </div>
            </div>
            <div class="fm-help">Puedes cerrar al dia siguiente. El sistema calcula las horas sobre la fecha de inicio del intervalo.</div>
            <div class="fm-sticky">
                <button id="fmCerrarIntervalo" type="button" class="fm-btn fm-btn-primary">Cerrar uso</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Historial de intervalos del dia</h3>
            <div id="fmIntervalosLista" class="fm-list"></div>
        </div>
    </section>

    <section id="fmPanelCombustible" class="fm-panel">
        <div class="fm-card">
            <div class="fm-section-title">
                <h3>Combustible</h3>
                <button id="fmToggleCombustibleForm" type="button" class="fm-btn fm-btn-soft">Agregar combustible</button>
            </div>
            <div class="fm-summary-band">
                <div class="fm-summary-box">
                    <span>Total galones</span>
                    <strong id="fmCombustibleTotalGalones">0.000</strong>
                </div>
                <div class="fm-summary-box">
                    <span>Total importe</span>
                    <strong id="fmCombustibleTotalImporte">S/.0.00</strong>
                </div>
                <div class="fm-summary-box">
                    <span>Cargas del dia</span>
                    <strong id="fmCombustibleTotalCargas">0</strong>
                </div>
            </div>
        </div>

        <div id="fmCombustibleFormCard" class="fm-card" style="display:none;">
            <h3>Nueva carga GLP</h3>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmCombustibleFecha">Fecha</label>
                    <input id="fmCombustibleFecha" type="date" value="@Model.FechaOperacionInicial.ToString("yyyy-MM-dd")" max="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fm-field">
                    <label for="fmCombustibleGalones">Galones</label>
                    <input id="fmCombustibleGalones" type="number" step="0.001" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmCombustibleImporte">Importe</label>
                    <input id="fmCombustibleImporte" type="number" step="0.01" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmCombustiblePago">Quien pago combustible</label>
                    <select id="fmCombustiblePago">
                        <option value="C">Chofer</option>
                        <option value="D">Dueno/Empresa</option>
                        <option value="P">Pendiente</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="fmCombustibleObservacion">Observacion</label>
                    <textarea id="fmCombustibleObservacion"></textarea>
                </div>
            </div>
            <div class="fm-file-note">Puedes registrar varias cargas el mismo dia. El recibo GLP se sube por cada carga registrada.</div>
            <div class="fm-sticky">
                <button id="fmRegistrarCombustible" type="button" class="fm-btn fm-btn-primary">Agregar combustible</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Recibo GLP</h3>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmCombustibleSeleccionado">Carga registrada</label>
                    <select id="fmCombustibleSeleccionado">
                        <option value="">Selecciona una carga...</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="fmReciboCombustibleArchivo">Archivo recibo GLP</label>
                    <input id="fmReciboCombustibleArchivo" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                </div>
                <div class="fm-field">
                    <label for="fmReciboCombustibleObs">Observacion del recibo</label>
                    <input id="fmReciboCombustibleObs" type="text" />
                </div>
            </div>
            <div class="fm-sticky">
                <button id="fmSubirReciboCombustible" type="button" class="fm-btn fm-btn-secondary" disabled>Subir recibo GLP</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Cargas del dia</h3>
            <div id="fmCombustiblesLista" class="fm-list"></div>
        </div>
    </section>

    <section id="fmPanelPagos" class="fm-panel">
        <div class="fm-card">
            <h3>Pagos</h3>
            <div class="fm-help">Este pago queda declarado para validacion. Todavia no descuenta recibos.</div>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmFechaPago">Fecha pago</label>
                    <input id="fmFechaPago" type="date" value="@Model.FechaOperacionInicial.ToString("yyyy-MM-dd")" max="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fm-field">
                    <label for="fmImportePago">Importe</label>
                    <input id="fmImportePago" type="number" step="0.01" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmFormaPago">Forma de pago</label>
                    <select id="fmFormaPago">
                        <option value="">Selecciona...</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="fmReferenciaPago">Referencia</label>
                    <input id="fmReferenciaPago" type="text" />
                </div>
                <div class="fm-field">
                    <label for="fmObservacionPago">Observacion</label>
                    <textarea id="fmObservacionPago"></textarea>
                </div>
            </div>
            <div class="fm-sticky">
                <button id="fmRegistrarPago" type="button" class="fm-btn fm-btn-primary" disabled>Registrar pago</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Voucher</h3>
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmPagoSeleccionado">Pago declarado</label>
                    <select id="fmPagoSeleccionado">
                        <option value="">Selecciona un pago...</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="fmVoucherArchivo">Archivo voucher</label>
                    <input id="fmVoucherArchivo" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                </div>
            </div>
            <div class="fm-sticky">
                <button id="fmSubirVoucher" type="button" class="fm-btn fm-btn-secondary" disabled>Subir voucher</button>
            </div>
        </div>

        <div class="fm-card">
            <h3>Pagos declarados</h3>
            <div id="fmPagosDeclarados" class="fm-list"></div>
        </div>
    </section>

    <section id="fmPanelHistorial" class="fm-panel">
        <div class="fm-card">
            <div class="fm-section-title">
                <div>
                    <h3>Detalle global del chofer</h3>
                    <div class="fm-help">Todos los contratos, recibos y pagos declarados visibles sin mezclar saldo real con pagos aún no aplicados.</div>
                </div>
                <button id="fmToggleDetalleGlobal" type="button" class="fm-btn fm-btn-soft fm-btn-inline">Ver detalle</button>
            </div>
            <div id="fmDetalleGlobalBody" style="display:none;">
                <div class="fm-subsection">
                    <h4>Recibos reales</h4>
                    <div id="fmDetalleGlobalRecibos" class="fm-list"></div>
                </div>
                <div class="fm-subsection">
                    <h4>Pagos declarados</h4>
                    <div id="fmDetalleGlobalPagos" class="fm-list"></div>
                </div>
            </div>
        </div>
        <div class="fm-card">
            <h3>Resumen del dia</h3>
            <div id="fmHistorialResumen" class="fm-list"></div>
        </div>
        <div class="fm-card">
            <h3>Recibos GLP recientes</h3>
            <div id="fmAdjuntosCombustible" class="fm-list"></div>
        </div>
        <div class="fm-card">
            <h3>Vouchers recientes</h3>
            <div id="fmAdjuntosPago" class="fm-list"></div>
        </div>
        <div class="fm-card">
            <h3>Adjuntos del dia</h3>
            <div id="fmAdjuntosOperacion" class="fm-list"></div>
        </div>
    </section>

    <nav class="fm-bottom-nav" aria-label="Navegacion mobile">
        <button type="button" class="fm-tab active" data-tab="intervalos"><i class="bi bi-hourglass-split"></i><span>Intervalos</span></button>
        <button type="button" class="fm-tab" data-tab="combustible"><i class="bi bi-fuel-pump"></i><span>Combustible</span></button>
        <button type="button" class="fm-tab" data-tab="pagos"><i class="bi bi-wallet2"></i><span>Pagos</span></button>
        <button type="button" class="fm-tab" data-tab="historial"><i class="bi bi-clock-history"></i><span>Historial</span></button>
    </nav>
</main>

<div id="fmEditPagoModal" class="fm-modal" aria-hidden="true">
    <div class="fm-modal-box">
        <div class="fm-modal-header">
            <div>
                <small>PAGO DECLARADO</small>
                <h3>Editar pago pendiente</h3>
            </div>
            <button id="fmCloseEditPago" type="button" class="fm-modal-close" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form id="fmEditPagoForm" class="fm-modal-body">
            <input id="fmEditPagoId" type="hidden" />
            <div class="fm-grid">
                <div class="fm-field">
                    <label for="fmEditFechaPago">Fecha pago</label>
                    <input id="fmEditFechaPago" type="date" max="@Model.FechaOperacionMaxima.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fm-field">
                    <label for="fmEditImportePago">Importe</label>
                    <input id="fmEditImportePago" type="number" step="0.01" inputmode="decimal" />
                </div>
                <div class="fm-field">
                    <label for="fmEditFormaPago">Forma de pago</label>
                    <select id="fmEditFormaPago">
                        <option value="">Selecciona...</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="fmEditReferenciaPago">Referencia</label>
                    <input id="fmEditReferenciaPago" type="text" />
                </div>
                <div class="fm-field">
                    <label for="fmEditObservacionPago">Observacion</label>
                    <textarea id="fmEditObservacionPago" placeholder="Opcional"></textarea>
                </div>
            </div>
            <div class="fm-help">El voucher existente se conserva. Si necesitas nueva evidencia, sube otro adjunto despues de guardar.</div>
            <div class="fm-sticky">
                <button id="fmGuardarEdicionPago" type="submit" class="fm-btn fm-btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/flota/flotaEstacionMobileSecure.js" asp-append-version="true"></script>
}
