@{ViewData["Title"]="Alquiler de vehiculos";Layout="~/Views/Shared/_LayoutGAP.cshtml";}
<link href="~/css/flota/flota.css" rel="stylesheet" asp-append-version="true" />
<form id="flotaToken">@Html.AntiForgeryToken()</form>
<main class="fleet-page">
 <header class="fleet-head"><div><span>OPERACION DE FLOTA</span><h2>Alquiler de vehiculos</h2><p>Control diario, deuda y combustible en una sola estacion.</p></div><input id="fFecha" type="date" /></header>
 <nav class="fleet-tabs"><button class="active" data-panel="pOperacion"><i class="bi bi-grid-1x2"></i> Operacion diaria</button><button data-panel="pContrato"><i class="bi bi-file-earmark-text"></i> Nuevo contrato</button><button data-panel="pMaestros"><i class="bi bi-car-front"></i> Maestros</button></nav>
 <section id="pOperacion" class="fleet-panel active">
  <div class="fleet-metrics"><article><span>Contratos activos</span><strong id="mContratos">0</strong></article><article><span>Generado</span><strong id="mGenerado">S/.0.00</strong></article><article><span>Kilometros</span><strong id="mKm">0 km</strong></article><article><span>Balance GLP</span><strong id="mGlp">S/.0.00</strong></article></div>
  <div class="station-layout"><aside><div class="section-title"><h5>Vehiculos activos</h5><small>Selecciona uno para cerrar el dia</small></div><div id="fleetCards" class="fleet-cards"></div></aside>
   <section id="dailyForm" class="daily-card empty"><div class="daily-empty"><i class="bi bi-car-front-fill"></i><strong>Selecciona un vehiculo</strong><span>Veras su conductor, tarifa y registro del dia.</span></div>
    <div class="daily-content"><div class="daily-selected"><div><small id="dNumero">-</small><h3 id="dPlaca">-</h3><span id="dChofer">-</span></div><div><span id="dModalidad" class="mode-badge">-</span><strong id="dTarifa">S/.0.00</strong></div></div>
     <div class="work-choice"><button type="button" data-work="true" class="worked"><i class="bi bi-check-circle-fill"></i><span>Si trabajo<small>Generar cobro del dia</small></span></button><button type="button" data-work="false" class="not-worked"><i class="bi bi-x-circle-fill"></i><span>No trabajo<small>Registrar el motivo</small></span></button></div>
     <div class="form-grid"><label>Motivo<select id="dMotivo"></select></label><label class="km-field">Km inicial<input id="dKmIni" type="number" step="0.01" /></label><label class="km-field">Km final<input id="dKmFin" type="number" step="0.01" /></label><label>Combustible S/.<input id="dCombustible" type="number" step="0.01" value="0" /></label><label>Galones<input id="dGalones" type="number" step="0.001" value="0" /></label><label>Pagado por<select id="dPaga"><option value="">Sin carga</option><option value="C">Conductor</option><option value="P">Propietario</option></select></label></div>
     <label class="obs">Observacion<textarea id="dObs" rows="2"></textarea></label><button id="btnGuardarDia" class="primary-action"><i class="bi bi-check2-square"></i> Guardar cierre del dia</button>
    </div></section>
  </div>
 </section>
 <section id="pContrato" class="fleet-panel"><div class="form-shell"><div class="section-title"><h5>Crear contrato de alquiler</h5><small>Diario o puerta libre, preparado para control de kilometraje.</small></div><div class="form-grid contract-grid"><label>Vehiculo<select id="cVehiculo"></select></label><label>Conductor<select id="cChofer"></select></label><label>Modalidad<select id="cModalidad"></select></label><label>Periodicidad del recibo<select id="cPeriodicidad"><option value="S">Semanal</option><option value="Q">Quincenal</option><option value="M">Mensual</option></select></label><label>Fecha inicio<input id="cInicio" type="date" /></label><label>Fecha fin<input id="cFin" type="date" /></label><label>Tarifa diaria<input id="cTarifa" type="number" step="0.01" /></label></div><div class="toggles"><label><input id="cDomingo" type="checkbox" /> Cobrar domingos</label><label><input id="cKm" type="checkbox" /> Controlar kilometraje y GLP</label></div><label class="obs">Observacion<textarea id="cObs" rows="2"></textarea></label><button id="btnContrato" class="primary-action"><i class="bi bi-file-earmark-plus"></i> Crear contrato</button></div></section>
 <section id="pMaestros" class="fleet-panel"><div class="masters-grid"><div class="form-shell"><div class="section-title"><h5>Nuevo vehiculo</h5><small>Configura GLP solo cuando corresponda.</small></div><div class="form-grid"><label>Placa<input id="vPlaca" /></label><label>Marca<input id="vMarca" /></label><label>Modelo<input id="vModelo" /></label><label>Año<input id="vAnio" type="number" /></label><label>Galones tanque<input id="vGalones" type="number" step="0.001" value="11.641" /></label><label>Precio por galon<input id="vPrecio" type="number" step="0.01" value="6.50" /></label><label>Rendimiento tanque (km)<input id="vRendimiento" type="number" step="0.01" value="210" /></label></div><label class="toggle-line"><input id="vCompartido" type="checkbox" checked /> Vehiculo personal compartido</label><button id="btnVehiculo" class="secondary-action"><i class="bi bi-plus-circle"></i> Registrar vehiculo</button></div>
 <div class="form-shell"><div class="section-title"><h5>Nuevo conductor</h5><small>Datos operativos para contrato y reportes.</small></div><div class="form-grid"><label>Nombres<input id="chNombre" /></label><label>Documento<input id="chDocumento" /></label><label>Telefono<input id="chTelefono" /></label><label>Licencia<input id="chLicencia" /></label></div><button id="btnChofer" class="secondary-action"><i class="bi bi-person-plus"></i> Registrar conductor</button></div></div></section>
</main>
@section Scripts{<script src="~/js/flota/flotaEstacion.js" asp-append-version="true"></script>}
