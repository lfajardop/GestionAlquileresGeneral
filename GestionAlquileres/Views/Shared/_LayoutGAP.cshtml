<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGA</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

    <!-- CSS propio -->
@*     <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" /> *@
    <link href="~/css/layout/layout.css" rel="stylesheet" />
</head>

<body>

    <div class="app-container">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="logo">DSI</div>

            <ul class="menu">

                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li>
                    <a asp-controller="Incidencias" asp-action="VerDocumento">
                        <i class="bi bi-file-earmark-text"></i> Incidencias
                    </a>
                </li>

                <li class="menu-title">Mantenimientos</li>

                <li><a asp-controller="PerfilUsuario" asp-action="Index"><i class="bi bi-person-badge"></i> Perfiles</a></li>
                <li><a asp-controller="Operario" asp-action="Index"><i class="bi bi-gear"></i> Operarios</a></li>
                <li><a asp-controller="Corporacion" asp-action="Index"><i class="bi bi-building"></i> Corporaciones</a></li>
                <li><a asp-controller="Usuario" asp-action="Index"><i class="bi bi-person"></i> Usuarios</a></li>
                <li><a asp-controller="UsuarioCorporacionEmision" asp-action="Index"><i class="bi bi-diagram-3"></i> Usuario Corp</a></li>

                <li class="menu-title">Clientes</li>

                <li>
                    <a asp-controller="Cliente" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>

                <li class="menu-title">Préstamos</li>

                <li>
                    <a asp-controller="Prestamo" asp-action="Index">
                        <i class="bi bi-journal-text"></i> Préstamos
                    </a>
                </li>

                <li>
                    <a asp-controller="Prestamo" asp-action="CuentaCorriente">
                        <i class="bi bi-card-list"></i> Cuenta corriente
                    </a>
                </li>

                <li>
                    <a asp-controller="Prestamo" asp-action="PagoGlobal">
                        <i class="bi bi-cash-coin"></i> Pago global
                    </a>
                </li>

                  <li>
                     <a asp-controller="Prestamo" asp-action="Continuacion">
                         <i class="bi bi-calendar-plus"></i> Continuación
                      </a>
                  </li>

                  <li>
                     <a asp-controller="Refinanciamiento" asp-action="Index">
                         <i class="bi bi-intersect"></i> Refinanciación
                      </a>
                  </li>

                  <li>
                     <a asp-controller="Compensacion" asp-action="Index">
                         <i class="bi bi-arrow-left-right"></i> Compensaciones
                      </a>
                  </li>

                <li class="menu-title">Alquileres</li>
                <li class="menu-group">
                    <details open>
                        <summary>
                            <span class="menu-group__label"><i class="bi bi-truck-front"></i> Flota</span>
                            <i class="bi bi-chevron-down menu-group__icon"></i>
                        </summary>
                        <ul class="submenu">
                            <li class="submenu-title">Panel principal</li>
                            <li>
                                <a asp-controller="Flota" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard Flota
                                </a>
                            </li>

                            <li class="submenu-title">Maestros</li>
                            <li>
                                <a asp-controller="Flota" asp-action="Contratos">
                                    <i class="bi bi-file-earmark-text"></i> Contratos
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Flota" asp-action="UsuariosMobile">
                                    <i class="bi bi-phone"></i> Usuarios Mobile
                                </a>
                            </li>
                            @* TODO: Habilitar /Flota/Vehiculos cuando exista la pantalla. *@
                            @* TODO: Habilitar /Flota/Choferes cuando exista la pantalla. *@

                            <li class="submenu-title">Operación</li>
                            <li>
                                <a asp-controller="Flota" asp-action="AdminCalendario">
                                    <i class="bi bi-calendar3"></i> Calendario Admin
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Flota" asp-action="EstacionMobile">
                                    <i class="bi bi-phone-landscape"></i> Estación Mobile
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Flota" asp-action="MobileLogin">
                                    <i class="bi bi-shield-lock"></i> Login Mobile
                                </a>
                            </li>

                            <li class="submenu-title">Finanzas Flota</li>
                            <li>
                                <a asp-controller="Flota" asp-action="DeudaChoferes">
                                    <i class="bi bi-cash-stack"></i> Deuda Choferes
                                </a>
                            </li>
                            @* TODO: Habilitar /Flota/AdminPagoContrato cuando exista la pantalla. *@
                            @* TODO: Habilitar /Flota/PagosGlobalesChofer cuando exista la pantalla. *@

                            @* TODO: Habilitar /Flota/UsoPropietario cuando exista la pantalla. *@
                            @* TODO: Habilitar /Flota/Reportes cuando exista la pantalla. *@
                        </ul>
                    </details>
                </li>

                <li class="menu-title">Reportes</li>

                <li>
                    <a asp-controller="Reporte" asp-action="DeudaActual">
                        <i class="bi bi-bar-chart-line"></i> Deuda actual
                    </a>
                </li>

                <li>
                    <a asp-controller="Reporte" asp-action="EstadoCuentaCliente">
                        <i class="bi bi-file-earmark-person"></i> Estado de cuenta
                    </a>
                </li>

                <li class="menu-title">Caja personal</li>

                <li>
                    <a asp-controller="YapeImportacion" asp-action="Index">
                        <i class="bi bi-phone"></i> Importar Yape
                    </a>
                </li>

            </ul>
        </aside>

        <!-- MAIN -->
        <div class="main-content">

            <!-- TOPBAR -->
            <header class="topbar">

                <button id="toggleSidebar" class="btn btn-light">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-right">
                    <span class="me-2">Usuario</span>
                    <i class="bi bi-person-circle"></i>
                </div>

            </header>

            <!-- CONTENT -->
            <main class="content container-fluid">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- JS BASE -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Plugins -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- JS propio -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shared/webApp.js" asp-append-version="true"></script>

    <!-- Toggle Sidebar -->
    <script>
        $("#toggleSidebar").click(function () {
            $("#sidebar").toggleClass("collapsed");
        });
    </script>

    <!-- TOAST -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div id="appToast" class="toast align-items-center text-bg-primary border-0"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="appToastBody">...</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>

    <!-- SPINNER -->
    <div id="appSpinner" class="app-spinner d-none" aria-hidden="true">
        <div class="app-spinner__backdrop"></div>
        <div class="app-spinner__box" role="status" aria-live="polite">
            <div class="spinner-border" role="status"></div>
            <div class="app-spinner__text">Procesando...</div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
