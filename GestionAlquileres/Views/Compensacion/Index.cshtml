@{ViewData["Title"]="Compensaciones";Layout="~/Views/Shared/_LayoutGAP.cshtml";}
<link rel="stylesheet" href="~/css/compensacion/index.css" asp-append-version="true" />
<div class="container-fluid co-page">@Html.AntiForgeryToken()
 <header class="co-header"><div><span>Préstamos</span><h3>Compensaciones</h3><p>Cruza saldos a favor contra deuda sin mover caja.</p></div><a asp-controller="Prestamo" asp-action="CuentaCorriente" class="btn co-btn-light"><i class="bi bi-card-list"></i> Cuenta corriente</a></header>
 <div class="co-flow"><b>1</b> Persona <i class="bi bi-chevron-right"></i><b>2</b> Saldo a favor <i class="bi bi-chevron-right"></i><b>3</b> Deuda <i class="bi bi-chevron-right"></i><b>4</b> Simular y aplicar</div>
 <section class="co-card"><div class="co-title"><div><b>1. Persona</b><small>El saldo a favor y los préstamos deben pertenecer a la misma persona.</small></div></div><div class="row g-2 align-items-end"><div class="col-lg-9"><label>Buscar persona</label><div class="input-group"><input id="coBuscar" class="form-control" placeholder="Nombre, DNI o RUC"><button id="coBtnBuscar" class="btn btn-primary"><i class="bi bi-search"></i></button></div><div id="coResultados" class="co-results d-none"></div></div><div class="col-lg-3"><label>Fecha de corte</label><input id="coFecha" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div></div><div id="coPersona" class="co-person d-none"><i class="bi bi-person-check"></i><div><small>Persona seleccionada</small><b id="coPersonaNombre"></b></div></div></section>
 <div class="row g-3"><div class="col-xl-5"><section class="co-card h-100"><div class="co-title"><div><b>2. Saldos a favor</b><small>Importes que la empresa reconoce a favor de esta persona.</small></div><button id="coNuevaOb" class="btn co-btn-light btn-sm"><i class="bi bi-plus-lg"></i> Registrar</button></div><div id="coObForm" class="co-ob-form d-none"><div class="row g-2"><div class="col-7"><label>Concepto</label><select id="coConcepto" class="form-select"></select></div><div class="col-5"><label>Importe</label><input id="coObImporte" type="number" min="0.01" step="0.01" class="form-control text-end"></div><div class="col-5"><label>Fecha</label><input id="coObFecha" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div><div class="col-7"><label>Referencia</label><input id="coReferencia" class="form-control" maxlength="80" placeholder="Factura, trabajo, acuerdo..."></div><div class="col-12"><label>Observación</label><input id="coObObs" class="form-control" maxlength="300"></div></div><div class="co-form-actions"><button id="coCancelarOb" class="btn btn-light btn-sm">Cancelar</button><button id="coGuardarOb" class="btn btn-success btn-sm"><i class="bi bi-check2"></i> Guardar saldo</button></div></div><div class="table-responsive"><table class="table co-table"><thead><tr><th></th><th>Concepto</th><th>Fecha</th><th class="text-end">Disponible</th></tr></thead><tbody id="coObBody"><tr><td colspan="4" class="co-empty">Selecciona una persona.</td></tr></tbody></table></div></section></div>
 <div class="col-xl-7"><section class="co-card h-100"><div class="co-title"><div><b>3. Préstamos a compensar</b><small>Se aplica primero a cuotas vencidas, interés y luego capital.</small></div><button id="coTodos" class="btn co-btn-light btn-sm"><i class="bi bi-check2-square"></i> Todos</button></div><div class="table-responsive"><table class="table co-table"><thead><tr><th></th><th>Préstamo</th><th>Fin</th><th class="text-end">Vencido</th><th class="text-end">Saldo total</th><th class="text-center">Cuotas</th></tr></thead><tbody id="coPrestBody"><tr><td colspan="6" class="co-empty">Selecciona una persona.</td></tr></tbody></table></div></section></div></div>
 <section class="co-card"><div class="co-title"><div><b>4. Simulación</b><small>La compensación no registra efectivo, Yape ni movimiento de caja.</small></div><button id="coSimular" class="btn btn-primary"><i class="bi bi-calculator"></i> Simular distribución</button></div><div class="row g-2 align-items-end"><div class="col-md-3"><label>Importe a compensar</label><input id="coImporte" type="number" min="0.01" step="0.01" class="form-control text-end"></div><div class="col-md-3"><label>Alcance de cuotas</label><select id="coSoloVencidas" class="form-select"><option value="true">Solo vencidas al corte</option><option value="false">Incluir futuras</option></select></div><div class="col-md-6"><label>Observación de la compensación</label><input id="coObs" class="form-control" maxlength="300"></div></div>
 <div id="coPreview" class="co-preview d-none"><div class="co-metrics"><div><small>Saldo a favor antes</small><b id="coPAntes"></b></div><div><small>Aplicado a interés</small><b id="coPInteres"></b></div><div><small>Aplicado a capital</small><b id="coPCapital"></b></div><div class="main"><small>Importe compensado</small><b id="coPAplicado"></b></div><div><small>Saldo a favor después</small><b id="coPDespues"></b></div></div><div class="table-responsive"><table class="table co-table"><thead><tr><th>Orden</th><th>Préstamo/cuota</th><th>Vence</th><th class="text-end">Saldo antes</th><th class="text-end">Interés</th><th class="text-end">Capital</th><th class="text-end">Saldo después</th></tr></thead><tbody id="coPreviewBody"></tbody></table></div></div>
 <div class="co-apply"><span id="coPaso"><i class="bi bi-info-circle"></i> Selecciona saldo a favor y deuda.</span><button id="coAplicar" class="btn btn-success" disabled><i class="bi bi-intersect"></i> Aplicar compensación</button></div></section>
 <section class="co-card"><div class="co-title"><div><b>Historial</b><small>Aplicadas y revertidas, con constancia imprimible.</small></div><button id="coRecargar" class="btn co-btn-light btn-sm"><i class="bi bi-arrow-clockwise"></i></button></div><div class="table-responsive"><table class="table co-table"><thead><tr><th>Número</th><th>Persona</th><th>Fecha</th><th>Concepto</th><th>Cuotas</th><th class="text-end">Importe</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="coHistBody"></tbody></table></div></section>
</div><script src="~/js/compensacion/index.js" asp-append-version="true"></script>
