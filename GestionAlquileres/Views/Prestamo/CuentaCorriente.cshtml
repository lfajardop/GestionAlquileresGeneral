@{
    ViewData["Title"] = "Cuenta Corriente";
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}

<link href="~/css/styles.css" rel="stylesheet" />
<link href="~/css/prestamo/lista-prestamo.css" rel="stylesheet" />

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Cuenta Corriente</h3>
            <small class="text-muted">Resumen general de clientes y detalle de deudas.</small>
        </div>

        <a asp-controller="Prestamo"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Volver a préstamos
        </a>
    </div>

    <div class="card shadow-sm rounded-4 border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Resumen general de clientes</h5>
                    <small class="text-muted">Clientes con deuda consolidada.</small>
                </div>
                <button id="btnRefrescarCtacteGeneral" class="btn btn-outline-primary rounded-3">
                    Cargar resumen clientes
                </button>

            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Clientes</div>
                        <div id="cgTotalClientes" class="fw-bold fs-5">0</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Préstamos</div>
                        <div id="cgTotalPrestamos" class="fw-bold fs-5">0</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Capital</div>
                        <div id="cgTotalCapital" class="fw-bold fs-5">S/ 0.00</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Programado</div>
                        <div id="cgTotalProgramado" class="fw-bold fs-5">S/ 0.00</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Pagado</div>
                        <div id="cgTotalPagado" class="fw-bold fs-5 text-success">S/ 0.00</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Saldo</div>
                        <div id="cgTotalSaldo" class="fw-bold fs-5 text-danger">S/ 0.00</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="tblCtacteGeneral" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Préstamos</th>
                            <th>Capital</th>
                            <th>Programado</th>
                            <th>Pagado</th>
                            <th>Saldo</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Detalle por cliente</h5>
                    <small class="text-muted">Selecciona un cliente desde el resumen general.</small>
                </div>

                <div class="d-flex gap-2">
                    <button id="btnExportarDetalleClienteExcel" class="btn btn-success btn-sm rounded-3" disabled>
                        <i class="bi bi-file-earmark-excel me-1"></i> Exportar detalle
                    </button>
                </div>
            </div>

            <input type="hidden" id="Cc_Cod_TipAnex" />
            <input type="hidden" id="Cc_Cod_Anxo" />

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Préstamos</div>
                        <div id="ccCantPrestamos" class="fw-bold fs-5">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Capital</div>
                        <div id="ccTotalCapital" class="fw-bold fs-5">S/ 0.00</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Programado</div>
                        <div id="ccTotalProgramado" class="fw-bold fs-5">S/ 0.00</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="small text-muted">Saldo</div>
                        <div id="ccTotalSaldo" class="fw-bold fs-5 text-danger">S/ 0.00</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table id="tblCtacteDetalle" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Capital</th>
                            <th>Cuotas</th>
                            <th>% Int.</th>
                            <th>Total</th>
                            <th>Pagado</th>
                            <th>Saldo</th>
                            <th>Vencidas</th>
                            <th>Atraso</th>
                            <th>Concepto</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        

            <div class="d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Detalle por cuotas</h6>
                <button id="btnVerTodasCuotas" class="btn btn-sm btn-outline-secondary">
                    Ver todas
                </button>
            </div>

            <div id="lblPrestamoCuotasSeleccionado" class="small text-muted mb-2">
                Mostrando todas las cuotas del cliente
            </div>
            <div class="table-responsive">
                <table id="tblCtacteCuotas" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>ID Préstamo</th>
                            <th>Cuota</th>
                            <th>Vencimiento</th>
                            <th>Base</th>
                            <th>Interés</th>
                            <th>Cuota</th>
                            <th>Pagado</th>
                            <th>Saldo</th>
                            <th>Estado</th>
                            <th>Atraso</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/prestamo/prestamo-cuenta-corriente.js"></script>
}