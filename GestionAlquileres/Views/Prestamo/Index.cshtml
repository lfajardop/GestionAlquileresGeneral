@{
    ViewData["Title"] = "Préstamos";
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}

    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/prestamo/lista-prestamo.css" rel="stylesheet" />


<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Préstamos</h3>
            <small class="text-muted">Registro, simulación y control básico de préstamos.</small>
        </div>
        <button id="btnNuevoPrestamo" class="btn btn-primary rounded-3">
            <i class="bi bi-plus-circle me-1"></i> Nuevo préstamo
        </button>

        <a asp-controller="Prestamo"
           asp-action="CuentaCorriente"
           class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-journal-text me-1"></i> Cuenta corriente
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body">
                    <div class="text-muted small">Total préstamos</div>
                    <div id="lblTotalPrestamos" class="fs-3 fw-bold">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body">
                    <div class="text-muted small">Capital acumulado</div>
                    <div id="lblCapitalAcumulado" class="fs-3 fw-bold">S/ 0.00</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body">
                    <div class="text-muted small">Cuotas acumuladas</div>
                    <div id="lblCuotasAcumuladas" class="fs-3 fw-bold">0</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body">
            <table id="tblPrestamos" class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Documento</th>
                        <th>Fecha</th>
                        <th>Capital</th>
                        <th>Cuotas</th>
                        <th>Deuda Total</th>
                        <th>Pagado</th>
                        <th>Pendiente</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>


</div>

<div class="modal fade" id="mdlPrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Nuevo préstamo</h5>
                    <small class="text-muted">Simula primero y luego registra.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body pt-3">
                <form id="frmPrestamo" method="post">
                    @Html.AntiForgeryToken()

                    <div id="frmPrestamoMsg" class="alert d-none"></div>

                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="card border-0 bg-light rounded-4">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3">Datos del cliente</h6>

                                    <div class="mb-3">
                                        <label class="form-label">Cliente</label>
                                        <select id="Cod_Anxo" name="Cod_Anxo" class="form-select"></select>
                                        <input type="hidden" id="Cod_TipAnex" name="Cod_TipAnex" value="C" />
                                        <span class="field-error text-danger" data-valmsg-for="Cod_Anxo"></span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Fecha préstamo</label>
                                            <input type="date" class="form-control" id="Fecha" name="Fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            <span class="field-error text-danger" data-valmsg-for="Fecha"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Capital</label>
                                            <input type="number" step="0.01" class="form-control" id="Capital" name="Capital" />
                                            <span class="field-error text-danger" data-valmsg-for="Capital"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Almacén</label>
                                            <select class="form-select" id="Cod_Almacen" name="Cod_Almacen"></select>
                                            <span class="field-error text-danger" data-valmsg-for="Cod_Almacen"></span>
                                        </div>
                                    </div>

                                    <hr class="my-4" />

                                    <h6 class="fw-bold mb-3">Condiciones del préstamo</h6>

                                    <div class="row g-3">

                                        <div class="col-md-4">
                                            <label class="form-label">Modalidad</label>
                                            <select class="form-select" id="TipoModalidad" name="TipoModalidad">
                                                <option value="C" selected>Cuotas normales</option>
                                                <option value="I">Interés mensual + capital final</option>
                                                <option value="F">Todo Al Final</option>
                                            </select>
                                            <small class="text-muted">Define cómo se distribuye el capital en las cuotas.</small>
                                            <span class="field-error text-danger" data-valmsg-for="TipoModalidad"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Tipo interés</label>
                                            <select class="form-select" id="TipoInteres" name="TipoInteres">
                                                <option value="M" selected>Mensual fijo</option>
                                                <option value="N">Sin interés</option>
                                            </select>
                                            <small class="text-muted">Ejemplo: 15 significa 15% mensual.</small>
                                            <span class="field-error text-danger" data-valmsg-for="TipoInteres"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">% interés mensual</label>
                                            <input type="number" step="0.0001" class="form-control" id="PorcInteresMensual" name="PorcInteresMensual" value="0" />
                                            <span class="field-error text-danger" data-valmsg-for="PorcInteresMensual"></span>
                                        </div>
                                       

                                        <div class="col-md-4">
                                            <label class="form-label">Frecuencia pago</label>
                                            <select class="form-select" id="FrecuenciaPago" name="FrecuenciaPago">
                                                <option value="D">Diario</option>
                                                <option value="S">Semanal</option>
                                                <option value="M" selected>Mensual</option>
                                            </select>
                                            <small class="text-muted">Define cada cuánto vencerá cada cuota.</small>
                                            <span class="field-error text-danger" data-valmsg-for="FrecuenciaPago"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Fecha inicio cobro</label>
                                            <input type="date" class="form-control" id="FechaInicioCobro" name="FechaInicioCobro" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            <span class="field-error text-danger" data-valmsg-for="FechaInicioCobro"></span>
                                        </div>

                                      

                                        <div class="col-md-4">
                                            <label class="form-label">Fecha fin cobro</label>
                                            <input type="date" class="form-control" id="FechaFinCobro" name="FechaFinCobro" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            <span class="field-error text-danger" data-valmsg-for="FechaFinCobro"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Concepto</label>
                                            <select class="form-select" id="Cod_Concepto" name="Cod_Concepto"></select>
                                            <span class="field-error text-danger" data-valmsg-for="Cod_Concepto"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label d-block">Garantía / prenda</label>
                                            <div class="form-check form-switch mt-2">
                                                <input class="form-check-input" type="checkbox" id="TieneGarantia" name="TieneGarantia" value="true" />
                                                <label class="form-check-label" for="TieneGarantia">Este préstamo tiene garantía</label>
                                            </div>
                                            <input type="hidden" name="TieneGarantia" value="false" />
                                        </div>


                                        <div class="col-12">
                                            <label class="form-label">Observación</label>
                                            <textarea class="form-control" id="Observacion" name="Observacion" rows="3"></textarea>
                                            <span class="field-error text-danger" data-valmsg-for="Observacion"></span>
                                        </div>
                                        <div id="panelGarantia" class="row g-3 mt-1 d-none">
                                            <div class="col-md-4">
                                                <label class="form-label">Tipo garantía</label>
                                                <input type="text" class="form-control" id="TipoGarantia" name="TipoGarantia" placeholder="Ej. Lavadora, Laptop, TV" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Marca</label>
                                                <input type="text" class="form-control" id="MarcaGarantia" name="MarcaGarantia" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Modelo</label>
                                                <input type="text" class="form-control" id="ModeloGarantia" name="ModeloGarantia" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Serie</label>
                                                <input type="text" class="form-control" id="SerieGarantia" name="SerieGarantia" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Estado artículo</label>
                                                <input type="text" class="form-control" id="EstadoGarantia" name="EstadoGarantia" placeholder="Ej. Operativo, usado, con detalle" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Valor referencial</label>
                                                <input type="number" step="0.01" class="form-control" id="ValorGarantia" name="ValorGarantia" />
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Descripción garantía</label>
                                                <textarea class="form-control" id="DescripcionGarantia" name="DescripcionGarantia" rows="2"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="card border-0 bg-light rounded-4 h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold mb-0">Simulación</h6>
                                        <button type="button" id="btnSimularPrestamo" class="btn btn-outline-primary btn-sm rounded-3">
                                            Simular
                                        </button>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Nro cuotas</div>
                                                <div id="simNroCuotas" class="fw-bold fs-5">0</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Interés mensual</div>
                                                <div id="simInteresMensual" class="fw-bold fs-5">S/ 0.00</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Interés diario</div>
                                                <div id="simInteresDiario" class="fw-bold fs-5">S/ 0.00</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">TEA referencial</div>
                                                <div id="simTeaReferencial" class="fw-bold fs-5">0.0000 %</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Interés total</div>
                                                <div id="simInteresTotal" class="fw-bold fs-5 text-danger">S/ 0.00</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">N° Cuotas Comp</div>
                                               
                                                <div id="numCuotasComp" class="fw-bold fs-5 text-danger">0</div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Total a cobrar</div>
                                                <div id="simTotalCobrar" class="fw-bold fs-4 text-primary">S/ 0.00</div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Importe por cuota</div>
                                                <div id="simImporteCuota" class="fw-bold fs-4">S/ 0.00</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Cuota interés</div>
                                                <div id="simCuotaInteres" class="fw-bold fs-5">S/ 0.00</div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="border rounded-3 p-3 bg-white">
                                                <div class="small text-muted">Última cuota</div>
                                                <div id="simUltimaCuota" class="fw-bold fs-5">S/ 0.00</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-auto pt-4 d-grid gap-2">
                                        <button type="button" id="btnGuardarPrestamo" class="btn btn-primary btn-lg rounded-3">
                                            Guardar préstamo
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">
                                            Cerrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlPagosPrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Pagos del préstamo</h5>
                    <small class="text-muted">Consulta historial, deuda y registra pagos.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body pt-3">
                <input type="hidden" id="hidPagoIdPrestamo" />
                <input type="hidden" id="hidPagoNroCobranza" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cliente</label>
                        <div id="txtPagoCliente" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Documento</label>
                        <div id="txtPagoDocumento" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">ID Préstamo</label>
                        <div id="txtPagoIdPrestamo" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Nro Cobranza</label>
                        <div id="txtPagoNroCobranza" class="form-control bg-light"></div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Deuda total</div>
                                <div id="lblPagoDeudaTotal" class="fs-4 fw-bold">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Pagado hasta ahora</div>
                                <div id="lblPagoPagadoTotal" class="fs-4 fw-bold text-success">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Saldo pendiente</div>
                                <div id="lblPagoSaldoPendiente" class="fs-4 fw-bold text-danger">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" id="btnAbrirGenerarPago" class="btn btn-primary w-100 rounded-3">
                            <i class="bi bi-cash-coin me-1"></i> Generar pago
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblPagosPrestamo" class="table table-striped table-hover align-middle w-100">
                        <thead>
                            <tr>
                                <th>Cuota</th>
                                <th>Fecha pago</th>
                                <th>Forma pago</th>
                                <th>Caja / Banco</th>
                                <th>Importe</th>
                                <th>Deuda</th>
                                <th>Saldo</th>
                                <th>Glosa</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlGenerarPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Registrar pago</h5>
                    <small class="text-muted">El pago se aplicará a cuotas pendientes en orden.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body pt-3">
                <form id="frmGenerarPago">
                    @Html.AntiForgeryToken()

                    <div id="frmGenerarPagoMsg" class="alert d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha operación</label>
                            <input type="date" class="form-control" id="FecPago" name="FecPago" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Forma de pago</label>
                            <select class="form-select" id="FormaPago" name="FormaPago">
                                <option value="EFECTIVO" selected>Efectivo</option>
                                <option value="BANCARIO">Bancario</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Caja / Banco</label>
                            <select class="form-select" id="CodCajaChica" name="CodCajaChica"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Importe a pagar</label>
                            <input type="number" step="0.01" class="form-control" id="ImportePago" name="ImportePago" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Glosa</label>
                            <input type="text" class="form-control" id="GlosaPago" name="GlosaPago" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="PermitirExcedente" name="PermitirExcedente" value="true">
                                <label class="form-check-label" for="PermitirExcedente">Permitir excedente si el pago supera la deuda</label>
                            </div>
                            <input type="hidden" name="PermitirExcedente" value="false" />
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0">
                <button type="button" id="btnGuardarPagoPrestamo" class="btn btn-primary rounded-3">
                    Guardar pago
                </button>
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
<!-- Nuevos-->
<div class="modal fade" id="mdlDesembolsoPrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Desembolso del préstamo</h5>
                    <small class="text-muted">Registra uno o más tramos de desembolso desde caja.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body pt-3">
                <input type="hidden" id="hidDesIdPrestamo" />
                <input type="hidden" id="hidDesNroCobranza" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cliente</label>
                        <div id="txtDesCliente" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Documento</label>
                        <div id="txtDesDocumento" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">ID Préstamo</label>
                        <div id="txtDesIdPrestamo" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Nro Cobranza</label>
                        <div id="txtDesNroCobranza" class="form-control bg-light"></div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Capital</div>
                                <div id="lblDesCapital" class="fs-4 fw-bold">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Desembolsado</div>
                                <div id="lblDesTotalDesembolsado" class="fs-4 fw-bold text-success">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <div class="text-muted small">Saldo por desembolsar</div>
                                <div id="lblDesSaldoPendiente" class="fs-4 fw-bold text-danger">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" id="btnAbrirRegistrarDesembolso" class="btn btn-primary w-100 rounded-3">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Registrar desembolso
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblDesembolsosPrestamo" class="table table-striped table-hover align-middle w-100">
                        <thead>
                            <tr>
                                <th>Sec.</th>
                                <th>Fecha</th>
                                <th>Caja</th>
                                <th>Importe</th>
                                <th>Documento</th>
                                <th>Glosa</th>
                                <th>Mov.</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlRegistrarDesembolso" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Registrar desembolso</h5>
                    <small class="text-muted">Permite desembolso simple o mixto por varios tramos.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body pt-3">
                <form id="frmRegistrarDesembolso">
                    @Html.AntiForgeryToken()

                    <div id="frmRegistrarDesembolsoMsg" class="alert d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha desembolso</label>
                            <input type="date" class="form-control" id="FecDesembolso" name="FecDesembolso" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Forma de pago</label>
                            <select class="form-select" id="FormaPagoDesembolso" name="FormaPagoDesembolso"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Caja origen</label>
                            <select class="form-select" id="CodCajaChicaDesembolso" name="CodCajaChicaDesembolso"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Importe</label>
                            <input type="number" step="0.01" class="form-control" id="ImpDesembolso" name="ImpDesembolso" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Glosa</label>
                            <input type="text" class="form-control" id="GlosaDesembolso" name="GlosaDesembolso" />
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0">
                <button type="button" id="btnGuardarDesembolso" class="btn btn-primary rounded-3">
                    Guardar desembolso
                </button>
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlDetallePrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Detalle consolidado del préstamo</h5>
                    <small class="text-muted">Resumen general, cuotas, pagos y desembolsos.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-3">
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><b>ID:</b> <span id="detIdPrestamo"></span></div>
                    <div class="col-md-3"><b>Fecha:</b> <span id="detFecha"></span></div>
                    <div class="col-md-3"><b>Capital:</b> <span id="detCapital"></span></div>
                    <div class="col-md-3"><b>Interés:</b> <span id="detInteres"></span></div>

                    <div class="col-md-3"><b>Total cobrar:</b> <span id="detTotalCobrar"></span></div>
                    <div class="col-md-3"><b>Total pagado:</b> <span id="detTotalPagado"></span></div>
                    <div class="col-md-3"><b>Total desembolsado:</b> <span id="detTotalDesembolsado"></span></div>
                    <div class="col-md-3"><b>Saldo:</b> <span id="detSaldoPendiente"></span></div>

                    <div class="col-md-4"><b>Concepto:</b> <span id="detConcepto"></span></div>
                    <div class="col-md-8"><b>Observación:</b> <span id="detObservacion"></span></div>
                </div>

                <h6 class="fw-bold">Cuotas</h6>
                <div class="table-responsive mb-4">
                        <table  class="table table-sm table-striped table-bordered" id="tblDetalleCuotas">
                        <thead class="table-light">
                            <tr>
                                <th>Cuota</th>
                                <th>Vencimiento</th>
                                <th>Base</th>
                                <th>Interés</th>
                                <th>Total</th>
                                <th>Pagado</th>
                                <th>Saldo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <h6 class="fw-bold">Pagos</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-striped" id="tblDetallePagos">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Importe</th>
                                <th>Forma pago</th>
                                <th>Glosa</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <h6 class="fw-bold">Desembolsos</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-striped" id="tblDetalleDesembolsos">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Importe</th>
                                <th>Caja</th>
                                <th>Glosa</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="mdlEditarPrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">Editar préstamo</h5>
                    <small class="text-muted">Solo editable si aún no tiene pagos ni desembolsos.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-3">
                <form id="frmEditarPrestamo">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="Edit_Id_Prestamo" name="Id_Prestamo" />

                    <div id="frmEditarPrestamoMsg" class="alert d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha préstamo</label>
                            <input type="date" class="form-control" id="Edit_Fecha" name="Fecha" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Capital</label>
                            <input type="number" step="0.01" class="form-control" id="Edit_Capital" name="Capital" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Modalidad</label>
                            <select class="form-select" id="Edit_TipoModalidad" name="TipoModalidad">
                                <option value="C">Cuotas normales</option>
                                <option value="I">Interés mensual + capital final</option>
                                <option value="F">Todo al final</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tipo interés</label>
                            <select class="form-select" id="Edit_TipoInteres" name="TipoInteres">
                                <option value="M">Mensual fijo</option>
                                <option value="N">Sin interés</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">% interés mensual</label>
                            <input type="number" step="0.0001" class="form-control" id="Edit_PorcInteresMensual" name="PorcInteresMensual" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Frecuencia pago</label>
                            <select class="form-select" id="Edit_FrecuenciaPago" name="FrecuenciaPago">
                                <option value="D">Diario</option>
                                <option value="S">Semanal</option>
                                <option value="M">Mensual</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha inicio cobro</label>
                            <input type="date" class="form-control" id="Edit_FechaInicioCobro" name="FechaInicioCobro" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha fin cobro</label>
                            <input type="date" class="form-control" id="Edit_FechaFinCobro" name="FechaFinCobro" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Concepto</label>
                            <select class="form-select" id="Edit_Cod_Concepto" name="Cod_Concepto"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label d-block">Garantía / prenda</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="Edit_TieneGarantia" name="TieneGarantia" value="true" />
                                <label class="form-check-label" for="Edit_TieneGarantia">Este préstamo tiene garantía</label>
                            </div>
                            <input type="hidden" name="TieneGarantia" value="false" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Observación</label>
                            <textarea class="form-control" id="Edit_Observacion" name="Observacion" rows="3"></textarea>
                        </div>

                        <div id="Edit_panelGarantia" class="row g-3 mt-1 d-none">
                            <div class="col-md-4">
                                <label class="form-label">Tipo garantía</label>
                                <input type="text" class="form-control" id="Edit_TipoGarantia" name="TipoGarantia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Marca</label>
                                <input type="text" class="form-control" id="Edit_MarcaGarantia" name="MarcaGarantia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Modelo</label>
                                <input type="text" class="form-control" id="Edit_ModeloGarantia" name="ModeloGarantia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Serie</label>
                                <input type="text" class="form-control" id="Edit_SerieGarantia" name="SerieGarantia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Estado artículo</label>
                                <input type="text" class="form-control" id="Edit_EstadoGarantia" name="EstadoGarantia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Valor referencial</label>
                                <input type="number" step="0.01" class="form-control" id="Edit_ValorGarantia" name="ValorGarantia" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Descripción garantía</label>
                                <textarea class="form-control" id="Edit_DescripcionGarantia" name="DescripcionGarantia" rows="2"></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Observación garantía</label>
                                <textarea class="form-control" id="Edit_ObservacionGarantia" name="ObservacionGarantia" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
                <hr />
                <h6 class="fw-bold">Simulación nueva</h6>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Nro cuotas</div>
                            <div id="editSimNroCuotas" class="fw-bold fs-5">0</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Interés mensual</div>
                            <div id="editSimInteresMensual" class="fw-bold fs-5">S/ 0.00</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">TEA referencial</div>
                            <div id="editSimTeaReferencial" class="fw-bold fs-5">0.0000 %</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Interés total</div>
                            <div id="editSimInteresTotal" class="fw-bold fs-5">S/ 0.00</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Importe cuota</div>
                            <div id="editSimImporteCuota" class="fw-bold fs-5">S/ 0.00</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Última cuota</div>
                            <div id="editSimUltimaCuota" class="fw-bold fs-5">S/ 0.00</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="small text-muted">Total a cobrar</div>
                            <div id="editSimTotalCobrar" class="fw-bold fs-4 text-primary">S/ 0.00</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" id="btnGuardarEdicionPrestamo" class="btn btn-primary rounded-3">
                    Guardar cambios
                </button>
                <button type="button" id="btnSimularEdicionPrestamo" class="btn btn-outline-primary rounded-3">
                    Simular cambios
                </button>
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script src="~/js/prestamo/prestamo.js"></script>
}