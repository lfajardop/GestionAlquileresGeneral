@{
    ViewData["Title"] = "Deuda Actual";
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}

<link href="~/css/prestamo/lista-prestamo.css" rel="stylesheet" />

<div class="container-fluid py-3 reporte-deuda">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <div class="report-icon">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">Reporte de Deuda Actual</h3>
                <small class="text-muted">Saldos por cliente desde cuotas y cobranza.</small>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button id="btnExportExcel" type="button" class="btn btn-success rounded-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Excel
            </button>
            <button id="btnExportPdf" type="button" class="btn btn-danger rounded-3">
                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Desde</label>
                    <input id="FechaDesde" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Hasta</label>
                    <input id="FechaHasta" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Cliente / Documento</label>
                    <input id="Cliente" type="text" class="form-control" placeholder="Buscar cliente, documento o codigo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Estado</label>
                    <select id="Estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="V">Vencido</option>
                        <option value="P">Pendiente</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button id="btnGenerarReporte" type="button" class="btn btn-primary rounded-3">
                        <i class="bi bi-arrow-clockwise me-1"></i> Generar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="metric-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
                    <div>
                        <div id="lblClientes" class="fs-3 fw-bold">0</div>
                        <div class="small text-muted fw-semibold">Clientes con saldo</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="metric-icon bg-info-subtle text-info"><i class="bi bi-journal-text"></i></div>
                    <div>
                        <div id="lblPrestamos" class="fs-3 fw-bold">0</div>
                        <div class="small text-muted fw-semibold">Préstamos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="metric-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <div id="lblVencido" class="fs-3 fw-bold">S/.0.00</div>
                        <div class="small text-muted fw-semibold">Total vencido</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="metric-icon bg-success-subtle text-success"><i class="bi bi-cash-coin"></i></div>
                    <div>
                        <div id="lblSaldo" class="fs-3 fw-bold">S/.0.00</div>
                        <div class="small text-muted fw-semibold">Saldo actual</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-pie-chart me-1"></i> Deuda por cliente
                </div>
                <div class="card-body">
                    <canvas id="chartDeudaCliente" height="240"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-table me-1"></i> Resumen por cliente
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tblDeudaActual" class="table table-striped table-hover align-middle w-100">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Doc.</th>
                                    <th>Préstamos</th>
                                    <th>Cuotas</th>
                                    <th>Vencidas</th>
                                    <th>Saldo</th>
                                    <th>Vencido</th>
                                    <th>Atraso</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .reporte-deuda {
        color: #0f1f33;
    }

    .reporte-deuda .card {
        border: 1px solid #e3e8ef !important;
        box-shadow: 0 8px 20px rgba(15, 31, 51, 0.06) !important;
    }

    .reporte-deuda .card-header {
        border-bottom: 1px solid #e5ebf3;
        color: #10233f;
        min-height: 54px;
    }

    .reporte-deuda .form-label {
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .reporte-deuda .form-control,
    .reporte-deuda .form-select {
        border-color: #c9d4e2;
        min-height: 42px;
    }

    .reporte-deuda .btn {
        font-weight: 700;
        min-height: 42px;
    }

    .report-icon,
    .metric-icon {
        align-items: center;
        border-radius: 10px;
        display: inline-flex;
        height: 56px;
        justify-content: center;
        width: 56px;
    }

    .report-icon {
        background: #0b5cad;
        color: #fff;
        font-size: 1.55rem;
    }

    .metric-icon {
        font-size: 1.45rem;
        flex: 0 0 auto;
    }

    #tblDeudaActual thead th {
        background: #eef3f9;
        color: #4f6280;
        font-weight: 700;
        white-space: nowrap;
        text-transform: uppercase;
        font-size: .78rem;
    }

    #tblDeudaActual tbody td {
        border-color: #edf1f6;
        color: #10233f;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/reporte/deuda-actual.js" asp-append-version="true"></script>
}
