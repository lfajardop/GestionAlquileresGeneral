@{
    ViewData["Title"] = "Panel de Cobranza";
    Layout = "~/Views/Shared/_LayoutGAP.cshtml";
}
<link href="~/css/prestamo/lista-prestamo.css" rel="stylesheet" />
<div class="container-fluid py-3">
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="fw-bold mb-0">Panel de Cobranza</h3>
            <small class="text-muted">Resumen de préstamos, alquileres y rentas por vencer.</small>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <div class="text-muted small">Total por cobrar</div>
                    <div id="lblTotalPorCobrar" class="fs-3 fw-bold">S/ 0.00</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body">
                    <div class="text-muted small">Total vencido</div>
                    <div id="lblTotalVencido" class="fs-3 fw-bold text-danger">S/ 0.00</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm rounded-4 border-warning">
                <div class="card-body">
                    <div class="text-muted small">Vence en 14 días</div>
                    <div id="lblTotalPorVencer" class="fs-3 fw-bold text-warning">S/ 0.00</div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="tabCobranza" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="prest-tab" data-bs-toggle="tab" data-bs-target="#prestamosPane" type="button">
                Préstamos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="alq-tab" data-bs-toggle="tab" data-bs-target="#alquileresPane" type="button">
                Alquileres
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rent-tab" data-bs-toggle="tab" data-bs-target="#rentasPane" type="button">
                Rentas por vencer
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="prestamosPane">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <table id="tblPrestamos" class="table table-bordered table-striped align-middle w-100">
                        <thead>
                            <tr>
                                <th>Nro Cobranza</th>
                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Vencimiento</th>
                                <th>Cuota</th>
                                <th>Cancelado</th>
                                <th>Saldo</th>
                                <th>Días atraso</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="alquileresPane">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <table id="tblAlquileres" class="table table-bordered table-striped align-middle w-100">
                        <thead>
                            <tr>
                                <th>Nro Cobranza</th>
                                <th>Tipo</th>
                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Vencimiento</th>
                                <th>Saldo</th>
                                <th>Días atraso</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="rentasPane">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <table id="tblRentas" class="table table-bordered table-striped align-middle w-100">
                        <thead>
                            <tr>
                                <th>Nro Cobranza</th>
                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Vencimiento</th>
                                <th>Saldo</th>
                                <th>Días</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdlPagosPrestamo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pagos de préstamo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Nro Cobranza</label>
                        <div id="txtPagoNroCobranza" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cliente</label>
                        <div id="txtPagoCliente" class="form-control bg-light"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Documento</label>
                        <div id="txtPagoDocumento" class="form-control bg-light"></div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted small">Total programado</div>
                                <div id="lblPagoTotalProgramado" class="fw-bold fs-5">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted small">Total pagado</div>
                                <div id="lblPagoTotalPagado" class="fw-bold fs-5 text-success">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted small">Saldo pendiente</div>
                                <div id="lblPagoSaldoPendiente" class="fw-bold fs-5 text-danger">S/ 0.00</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" id="btnNuevoPagoPrestamo" class="btn btn-primary w-100">
                            Generar pago
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblPagosPrestamo" class="table table-sm table-bordered align-middle w-100">
                        <thead class="table-light">
                            <tr>
                                <th>Cuota</th>
                                <th>Fecha pago</th>
                                <th>Forma pago</th>
                                <th>Caja/Banco</th>
                                <th>Importe</th>
                                <th>Deuda</th>
                                <th>Saldo</th>
                                <th>Glosa</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="8" class="text-center text-muted">Sin datos aún</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cobranza-dashboard.js"></script>
}
